{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Jwt": {
    "Key": "TopSecretKeyNeedToChangeThisForProductionUseItIsSuperLong2024!",
    "Issuer": "NewsPortalAPI",
    "Audience": "NewsPortalUser"
  },
  "GoogleAuth": {
    "ClientId": "1087415603720-l0ij38kds4c26hlhfq5enrmuon9p5ne7.apps.googleusercontent.com"
  },
  "FacebookAuth": {
    "AppId": "1166698978956727"
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://news-portal-frontend-ten.vercel.app",
    "https://localhost:5173",
    "http://localhost:5174"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5433;Database=TheEverestEdit;Username=postgres;Password=admin"
  }
}